* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Bundled JavaScript can contain significant line-end spaces in string literals.
/public/build/assets/*.js whitespace=-blank-at-eol

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
