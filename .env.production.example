# Reference only: provision as private .env via the hosting panel. Never commit credentials.
APP_NAME=BootKode
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bootkode.example
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bootkode
DB_USERNAME=bootkode_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_PATH=/
CACHE_STORE=database
CACHE_PREFIX=bootkode_production_
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids
COURSE_QUEUE_DRIVER=database
BULK_QUEUE_DRIVER=database
# Set only after configuring and rehearsing cron or Supervisor.
PRODUCTION_QUEUE_MODE=unconfigured
PRODUCTION_CRON_MAX_RUNTIME=0

# Redis is optional. Switching drivers does not move already queued jobs.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=120

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
SCOUT_DRIVER=database
SCOUT_QUEUE=false

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BootKode

# Enable each provider only after credentials, account limits and privacy are verified.
BOOTKODE_AI_ENABLED=false
BOOTKODE_AI_PROVIDER=groq
BOOTKODE_AI_TIMEOUT=15
BOOTKODE_AI_RETRIES=1
BOOTKODE_AI_DAILY_REQUESTS=20
BOOTKODE_AI_CAREER_DAILY_REQUESTS=10
BOOTKODE_AI_RESUME_DAILY_REQUESTS=10
BOOTKODE_AI_MAX_INPUT_CHARACTERS=6000
BOOTKODE_AI_MAX_HISTORY_MESSAGES=12
BOOTKODE_AI_MAX_CONTEXT_CHARACTERS=12000
BOOTKODE_AI_COURSE_GENERATION_DAILY_REQUESTS=12
BOOTKODE_AI_COURSE_GENERATION_MAX_OUTPUT_TOKENS=6500
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT=15
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
COMMERCIAL_DEFAULT_CURRENCY=NGN
COMMERCIAL_TAX_RATE=0
COMMERCIAL_REFUNDS_USE_PAYSTACK_API=false
COMMERCIAL_REFUND_WINDOW_DAYS=7

# Keep existing videos off the application disk using the supported media provider.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_URL=
CLOUDINARY_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

JOB_ALERTS_SCHEDULE_ENABLED=false
LEARNING_REMINDERS_SCHEDULE_ENABLED=false
VITE_APP_NAME=BootKode
